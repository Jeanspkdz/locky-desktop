{
  "name": "locky-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Locky Desktop blocks chosen browser destinations on Windows.",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "smoke:native-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-native-host.ps1",
    "smoke:browser-watcher": "node scripts/browser-watcher-smoke.cjs",
    "smoke:browser-lifecycle": "node scripts/browser-lifecycle-smoke.cjs",
    "smoke:chrome-extension": "node scripts/browser-lifecycle-smoke.cjs --chrome-health",
    "smoke:desktop-recovery": "node scripts/desktop-recovery-smoke.cjs",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test",
    "test:e2e": "node scripts/browser-lifecycle-smoke.cjs",
    "test:domain": "node --test tests/domain/*.test.js",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  },
  "dependencies": {
    "koffi": "^3.3.5"
  }
}
